# Names only. Never commit real values.
SEAN_OS_DATABASE=/data/iac-ai.db
SEAN_OS_INTERFACE_TOKEN=
SEAN_OS_OPERATOR_TOKEN=

# Optional monitoring contract. Leave every value empty to keep monitoring disabled.
SEAN_OS_MONITOR_ROUTE_ID=
SEAN_OS_MONITOR_DESTINATION_KIND=
SEAN_OS_MONITOR_DESTINATION_REF=
SEAN_OS_MONITOR_INTERVAL_SECONDS=

# The only accepted value is SYNTHETIC_ONLY; empty keeps processing disabled.
SEAN_OS_ALERT_DELIVERY_MODE=

# Emergency use only: exact source schema to restore, followed by recovery hold.
# Leave empty during normal operation; setting this is separately approval-gated.
SEAN_OS_RESTORE_SCHEMA_VERSION=
